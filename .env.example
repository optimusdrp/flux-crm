# GEMINI_API_KEY: obrigatória para os endpoints de IA que usam Google
# Gemini como provider principal (auto-tag, qualificação de lead, análise
# de sentimento) — e como provider de reserva da triagem clínica, que usa
# Bedrock como principal. Ver server/ai/router.ts para a divisão completa.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: obrigatório em produção (NODE_ENV=production) — o servidor
# recusa subir sem ele. Usado para assinar/verificar os tokens de sessão
# (ver server/auth/authService.ts). Gerar um valor forte e único, nunca
# reaproveitar entre ambientes.
JWT_SECRET="troque-por-um-valor-forte-e-unico"

# DB_MODE: "dynalite" (padrão, não precisa definir) usa o banco local para
# testes. "dynamodb" aponta para o DynamoDB real da AWS — ver
# server/db/TABLE_SETUP.md para o checklist e os comandos de criação das
# tabelas antes de usar este modo.
DB_MODE="dynalite"

# AWS_REGION: obrigatória sempre — usada tanto pelo cliente do Amazon
# Bedrock (segunda IA do projeto, ver server/ai/providers/bedrock.provider.ts)
# quanto pelo DynamoDB real quando DB_MODE=dynamodb. As credenciais AWS
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, ou uma IAM role) seguem a
# cadeia de resolução padrão do AWS SDK — não são definidas aqui.
AWS_REGION="us-east-1"

# Antes de usar o Bedrock: a conta AWS precisa ter uma credencial IAM com
# permissão para bedrock:InvokeModel (política gerenciada
# AmazonBedrockLimitedAccess, ou uma política customizada). Modelos
# Anthropic (como o Claude Haiku 4.5 usado aqui) exigem, além disso, um
# formulário de "First Time Use" preenchido uma única vez por conta —
# acesse o Model catalog no console do Bedrock, abra o modelo no
# Playground e envie uma mensagem de teste; isso dispara o formulário
# automaticamente. A página antiga "Model access" foi descontinuada pela
# AWS em outubro de 2025 e não existe mais. Confirme também que a
# inference profile "us.anthropic.claude-haiku-4-5-20251001-v1:0" está
# disponível na região configurada acima — ver
# server/ai/providers/bedrock.provider.ts.

# Fase 2 de Prontidão Comercial: chave usada pela rota administrativa
# interna de cadastro de clínica (POST /api/billing/clinics) — restrita à
# equipe da própria MediFlux, nunca exposta a uma clínica cliente. Sem
# essa variável definida, a rota fica bloqueada (fail loud) em vez de
# aceitar qualquer requisição por engano. Gere um valor aleatório longo
# para produção; nunca reaproveite o mesmo valor de outro ambiente.
INTERNAL_OPS_KEY="dev-only-troque-isto-em-producao"

# Fase 5 de Prontidão Comercial: qual implementação de PaymentProvider usar
# (ver server/billing/providers/index.ts). "mock" é a implementação de
# referência sem depender de conta externa — trocar para o provedor real
# escolhido (ex.: "stripe") quando essa decisão de negócio for tomada.
PAYMENT_PROVIDER="mock"

# Segredo usado pelo MockPaymentProvider para assinar/validar webhooks de
# pagamento simulados (HMAC-SHA256) — nunca reaproveitar em produção; um
# provedor real forneceria seu próprio segredo de assinatura de webhook.
MOCK_PAYMENT_WEBHOOK_SECRET="dev-only-troque-isto-em-producao"

# Conexão real com WhatsApp (server/whatsapp/sessionManager.ts). Opcional
# — sem essa variável, o whatsapp-web.js usa o Chromium que o Puppeteer
# baixa automaticamente no `npm install`. Definir só se esse download
# falhar (rede bloqueada) e você já tiver um Chrome/Chromium instalado no
# sistema para apontar manualmente.
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"

